{
  "layer": "top",
  "position": "top",
  "height": 21,
  "spacing": 3,
  
  "modules-left": ["hyprland/workspaces", "tray"],
  "modules-center": ["pulseaudio", "network", "memory", "battery"],
  "modules-right": ["clock"],
  
  "clock": {
   "format": "{:%a %d %b  %I:%M %p}",
   "on-click": "kitty tty-clock -scnC 7",
  },
  
  "pulseaudio": {
   "format": "ㅤ{volume}%",
   "format-muted": "  MUTED",
   "scroll-step": 5,
   "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },
  
    "network": {
    "format-wifi": "ㅤ{signalStrength}%",
    "format-ethernet": "󰈀ㅤWIRED",
    "format-disconnected": "󰖪",
    "on-click": "control -wifi"
  },
  
    "cpu": {
    "format": "ㅤ{usage}%",
    "on-click": "gnome-system-monitor"
  },

  "memory": {
    "format": "ㅤ{used:0.1f}G",
   "on-click": "kitty btop"
  },

  "battery": {
    "format": "ㅤ{capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "tooltip": true,
    "path": "/sys/class/power_supply/BAT0"
  },
  
 }
